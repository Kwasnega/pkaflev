datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model User {
  user_id       Int      @id @default(autoincrement())
  email         String   @unique
  password_hash String
  role          String   // 'client', 'affiliate', 'admin'
  created_at    DateTime @default(now())
  
  affiliates    Affiliate?
  orders        Order[]
}

model Affiliate {
  affiliate_id        Int      @id @default(autoincrement())
  user_id             Int      @unique
  name                String
  commissions_earned  Decimal  @default(0.00)
  available_balance   Decimal  @default(0.00)
  number_of_referrals Int      @default(0)
  account_status      String   @default("active") // 'active', 'suspended'
  referral_link       String
  referral_code       String   @unique
  
  user                User     @relation(fields: [user_id], references: [user_id])
  referrals           AffiliateReferral[]
  orders              Order[]
  payouts             Payout[]
}

model Payout {
  payout_id      Int      @id @default(autoincrement())
  affiliate_id   Int
  amount         Decimal
  status         String   @default("pending") // 'pending', 'approved', 'declined'
  decline_reason String?
  created_at     DateTime @default(now())

  affiliate      Affiliate @relation(fields: [affiliate_id], references: [affiliate_id])
}

model Product {
  product_id     Int      @id @default(autoincrement())
  product_name   String
  price          Decimal
  cost_price     Decimal  @default(0.00)
  description    String?
  image          String?
  stock_quantity Int      @default(0)
  
  order_items    OrderItem[]
}

model Order {
  order_id      Int      @id @default(autoincrement())
  client_id     Int
  affiliate_id  Int?
  amount_paid   Decimal
  order_date    DateTime @default(now())
  status        String   // 'pending', 'failed', 'paid', 'fulfilled', 'cancelled'
  
  client        User     @relation(fields: [client_id], references: [user_id])
  affiliate     Affiliate? @relation(fields: [affiliate_id], references: [affiliate_id])
  order_items   OrderItem[]
  referrals     AffiliateReferral[]
}

model OrderItem {
  order_id          Int
  product_id        Int
  quantity          Int
  price_at_purchase Decimal

  order             Order   @relation(fields: [order_id], references: [order_id])
  product           Product @relation(fields: [product_id], references: [product_id])

  @@id([order_id, product_id])
}

model AffiliateReferral {
  referral_id       Int      @id @default(autoincrement())
  client_id         Int
  affiliate_id      Int
  order_id          Int
  date_referred     DateTime @default(now())
  commission_amount Decimal

  affiliate         Affiliate @relation(fields: [affiliate_id], references: [affiliate_id])
  order             Order     @relation(fields: [order_id], references: [order_id])
}